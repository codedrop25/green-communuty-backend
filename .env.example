# =============================================================================
# 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 는 커밋 금지 (.gitignore 등록됨)
# =============================================================================

# ----------------------------------------------------------------- 앱
ENVIRONMENT=local
PROJECT_NAME=community-backend
API_V1_PREFIX=/api/v1

# ----------------------------------------------------------------- 보안 / JWT
# 운영에서는 반드시 교체할 것 (교체하지 않으면 앱이 기동을 거부한다).
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-this-is-not-a-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ----------------------------------------------------------------- CORS / 쿠키
# 콤마로 구분한다. 예) http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000

# Refresh Token 쿠키 속성 (PLAN.md 4-4)
#  - 로컬(HTTP)           : COOKIE_SECURE=false, COOKIE_SAMESITE=lax
#  - 운영(동일 사이트)      : COOKIE_SECURE=true,  COOKIE_SAMESITE=lax
#  - 운영(프론트 도메인 분리): COOKIE_SECURE=true,  COOKIE_SAMESITE=none
#    ※ none 을 쓰려면 CORS 에 allow_credentials 가 필요하고 Origin 검증이 강제된다.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ----------------------------------------------------------------- 로그인 Rate Limit
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ----------------------------------------------------------------- MySQL
# MYSQL_PORT 는 docker compose 의 호스트측 매핑 포트로도 쓰인다.
# 로컬에 이미 MySQL 이 떠 있어 3306 이 점유된 경우 3307 등으로 바꾸면
# compose 포트 매핑과 앱 접속 설정이 함께 따라간다.
# (컨테이너로 실행되는 app 서비스는 내부 네트워크의 3306 을 쓰므로 영향받지 않는다)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_DB=community

# [필수] 비워두면 docker compose 가 기동을 거부한다.
# 'app', 'root', 'password' 같은 값은 절대 쓰지 말 것.
# 자동화 봇이 노출된 DB 를 상시 스캔하며, 약한 비밀번호는 즉시 뚫린다.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 커넥션 풀 (PLAN.md 7-2)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_ECHO=false

# AnyIO threadpool worker 수 (PLAN.md 3-3)
# 제약: THREADPOOL_MAX_WORKERS <= DB_POOL_SIZE + DB_MAX_OVERFLOW
# 위반하면 기동 시 ValidationError 로 즉시 실패한다.
THREADPOOL_MAX_WORKERS=40

# ----------------------------------------------------------------- Redis
# MYSQL_PORT 와 동일하게, 로컬 포트 충돌 시 6380 등으로 바꾼다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# [필수] Redis 는 기본적으로 인증이 없어 노출되면 즉시 장악된다.
# MYSQL_PASSWORD 와 마찬가지로 비워두면 docker compose 가 기동을 거부한다.
REDIS_PASSWORD=

# ----------------------------------------------------------------- S3 (선택)
# 미설정 시 스토리지 기능만 비활성화되고 앱은 정상 기동한다.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=ap-northeast-2
